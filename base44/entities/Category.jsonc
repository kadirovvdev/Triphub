{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "icon": {
      "type": "string",
      "default": "compass"
    },
    "description": {
      "type": "string",
      "maxLength": 280
    }
  },
  "required": [
    "name",
    "slug"
  ]
}